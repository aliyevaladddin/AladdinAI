# Production image for the AladdinAI FastAPI backend.
#
# - Multi-stage: stage 1 compiles the native C tools (aladdin-term terminal
#   daemon, aladdin-grep, aladdin-log-stream); stage 2 is a slim Python
#   runtime that receives only the prebuilt binaries — no gcc in prod.
# - Runs alembic migrations on container start before launching uvicorn, so
#   the user doesn't have to remember to run them after `docker compose up`.
# - No --reload, no volume mounts — the image is the source of truth.

# ── Stage 1: compile native C binaries ──────────────────────────────────────
FROM python:3.12-slim AS native-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc \
      make \
      libc6-dev \
      libzip-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /native
COPY native/ .
RUN make all

# ── Stage 2: Python runtime ─────────────────────────────────────────────────
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps that some Python packages need at runtime.
# ffmpeg: transcode browser webm/opus audio to PCM for Riva ASR (speech.py).
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      ffmpeg \
      libzip-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

# Overlay prebuilt native binaries over the sources copied above, so
# native_terminal_daemon and wrt_engine_service find them and skip make.
COPY --from=native-builder /native/aladdin-term         native/aladdin-term
COPY --from=native-builder /native/aladdin-grep         native/aladdin-grep
COPY --from=native-builder /native/aladdin-log-stream   native/aladdin-log-stream
COPY --from=native-builder /native/wrt-engine          native/wrt-engine
COPY --from=native-builder /native/wrt-validate        native/wrt-validate
COPY --from=native-builder /native/wrt-engine          native/wrt/wrt-engine
COPY --from=native-builder /native/wrt-validate        native/wrt/wrt-validate
RUN chmod +x native/aladdin-term native/aladdin-grep native/aladdin-log-stream native/wrt-engine native/wrt-validate native/wrt/wrt-engine native/wrt/wrt-validate

# Migrations + launch
RUN printf '#!/bin/sh\nset -e\necho "Running database migrations..."\nalembic upgrade head\nexec uvicorn app.main:app --host 0.0.0.0 --port 8000 "$@"\n' \
      > /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:8000/ || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
